# Copy to deploy/.env (gitignored) and replace every value. Never commit real values.
# The server refuses to start while TOKEN_HASH_KEY still contains "change-me".

# Public hostname of the console (agents connect here; Caddy gets a cert for it).
CAV_HOSTNAME=console.example.com
ACME_EMAIL=ops@example.com

# Space-separated networks allowed to reach the web UI (VPN / Tailscale).
ADMIN_ALLOWED_CIDRS=100.64.0.0/10

# Postgres passwords. Use URL-safe values: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
CAV_APP_DB_PASSWORD=change-me

# HMAC key for enrollment tokens, agent credentials and sessions: openssl rand -base64 32
# Back this up separately from database backups. Losing it forces every agent
# to re-enroll. See docs/operations.md before changing it.
TOKEN_HASH_KEY=change-me
# Set only during a key rotation (docs/operations.md).
TOKEN_HASH_KEY_PREVIOUS=

# Agents count as offline after this many seconds without a heartbeat.
AGENT_OFFLINE_AFTER_SECONDS=180

# Directory holding signed agent release files served at /downloads/.
CAV_DOWNLOADS_PATH=./downloads
